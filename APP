<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mi Aplicación</title>

    <link rel="stylesheet" href="css/style.css">

</head>

<body>

    <div class="app-container">

        <!-- ========================= -->
        <!-- BARRA LATERAL -->
        <!-- ========================= -->

        <aside class="sidebar">

            <div class="sidebar-header">
                <h2>MI APP</h2>
            </div>

            <nav class="menu">

                <button
                    class="menu-item active"
                    onclick="mostrarPagina('menu1', this)">
                    Menú 1
                </button>

                <button
                    class="menu-item"
                    onclick="mostrarPagina('menu2', this)">
                    Menú 2
                </button>

                <button
                    class="menu-item"
                    onclick="mostrarPagina('menu3', this)">
                    Menú 3
                </button>

            </nav>

            <div class="sidebar-footer">

                <button
                    class="logout-button"
                    onclick="cerrarSesion()">
                    Cerrar sesión
                </button>

            </div>

        </aside>


        <!-- ========================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================= -->

        <main class="main-content">

            <!-- MENÚ 1 -->

            <section id="menu1" class="page-section active-section">

                <div class="page-header">
                    <h1>Menú 1</h1>
                    <p>
                        Página principal del sistema.
                    </p>
                </div>

                <div class="content-card">

                    <h2>Contenido del Menú 1</h2>

                    <p>
                        Aquí se colocará el contenido
                        correspondiente al primer módulo.
                    </p>

                </div>

            </section>


            <!-- MENÚ 2 -->

            <section id="menu2" class="page-section">

                <div class="page-header">
                    <h1>Menú 2</h1>
                    <p>
                        Módulo de consulta.
                    </p>
                </div>

                <div class="content-card">

                    <h2>Contenido del Menú 2</h2>

                    <p>
                        Aquí se podrá consultar información
                        de la base de datos.
                    </p>

                </div>

            </section>


            <!-- MENÚ 3 -->

            <section id="menu3" class="page-section">

                <div class="page-header">
                    <h1>Menú 3</h1>
                    <p>
                        Módulo de registro.
                    </p>

                </div>

                <div class="content-card">

                    <h2>Contenido del Menú 3</h2>

                    <p>
                        Aquí se podrán registrar o modificar
                        datos.
                    </p>

                </div>

            </section>

        </main>

    </div>

    <script src="js/app.js"></script>

</body>

</html>

